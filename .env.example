# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your local setup.
# ==============================================================================

# Custom SemanticKITTI Dataset Root Directory (optional, defaults to ./kitti_dataset)
DATASET_ROOT=kitti_dataset

# Hardware Acceleration: 'auto', 'cuda', 'cuda:0', or 'cpu'
CUDA_VISIBLE_DEVICES=0

# Visualization Web Server Port
PORT=8080
HOST=0.0.0.0

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
